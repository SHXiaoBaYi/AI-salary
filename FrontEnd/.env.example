# 前端环境变量示例（复制为 .env.development.local 可覆盖）
#
# 测试与生产都是 ECS 47.99.95.38。
# 线上构建不要设置 VITE_UPLOAD_PUBLIC_BASE：uploadUrl 跟当前页面同源拼 /shxby/api。
#
# 本地开发默认连这台 ECS：
# VITE_API_PROXY_TARGET=http://47.99.95.38/shxby
# VITE_UPLOAD_PUBLIC_BASE=http://47.99.95.38/shxby/api
#
# 改回本机后端：
# VITE_API_PROXY_TARGET=http://127.0.0.1:8099
# VITE_UPLOAD_PUBLIC_BASE=

VITE_API_PROXY_TARGET=http://47.99.95.38/shxby
VITE_UPLOAD_PUBLIC_BASE=http://47.99.95.38/shxby/api
